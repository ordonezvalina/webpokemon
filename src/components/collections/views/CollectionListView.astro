---
import { getLineLabel } from "../../../lib/figureTaxonomy.js";
import type { CollectionViewItem } from "../../../lib/collectionViews";

interface Props {
  items: CollectionViewItem[];
}

const { items } = Astro.props;
---

<ul class="space-y-2">
  {
    items.map((item) => (
      <li>
        <a
          href={`/collection/${item.slug}/`}
          class="group flex items-center gap-4 rounded-xl border border-zinc-200/80 bg-white p-3 shadow-sm transition hover:border-zinc-400 hover:shadow-md dark:border-zinc-800/50 dark:bg-zinc-900 dark:hover:border-zinc-600"
        >
          <div class="h-16 w-16 flex-shrink-0 overflow-hidden rounded-lg bg-zinc-100 dark:bg-zinc-800/50">
            {item.coverImage ? (
              <img
                src={item.coverImage}
                alt={`Cover of ${item.collection.name}`}
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="grid h-full w-full place-items-center text-xs font-semibold text-zinc-400 dark:text-zinc-600">
                {item.collection.name}
              </div>
            )}
          </div>

          <div class="min-w-0 flex-1">
            <h2 class="truncate text-base font-semibold leading-tight text-zinc-900 dark:text-white">
              {item.collection.name}
            </h2>

            <p class="text-sm text-zinc-500 dark:text-zinc-400">
              {item.dateLabel && <span>{item.dateLabel}</span>}
              {item.dateLabel && item.figureCount > 0 && <span> · </span>}
              {item.figureCount} figure{item.figureCount === 1 ? "" : "s"}
              {item.releaseCount > 0 && (
                <span>
                  {" "}
                  · {item.releaseCount} release{item.releaseCount === 1 ? "" : "s"}
                </span>
              )}
            </p>

            {Object.keys(item.lineCounts).length > 0 && (
              <p class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-xs text-zinc-500 dark:text-zinc-400">
                {Object.entries(item.lineCounts)
                  .sort(([, a], [, b]) => b - a)
                  .map(([line, count]) => (
                    <span>{count} {getLineLabel(line)}</span>
                  ))}
              </p>
            )}
          </div>
        </a>
      </li>
    ))
  }
</ul>
