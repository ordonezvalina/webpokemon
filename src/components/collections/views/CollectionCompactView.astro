---
import type { CollectionViewItem } from "../../../lib/collectionViews";

interface Props {
  items: CollectionViewItem[];
}

const { items } = Astro.props;
---

<section class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
  {
    items.map((item) => (
      <a
        href={`/collection/${item.slug}/`}
        class="group block overflow-hidden rounded-xl border border-zinc-200/80 bg-white shadow-sm transition hover:border-zinc-400 hover:shadow-md dark:border-zinc-800/50 dark:bg-zinc-900 dark:hover:border-zinc-600"
      >
        <div class="relative aspect-[4/3] overflow-hidden bg-zinc-100 dark:bg-zinc-800/50">
          {item.coverImage ? (
            <img
              src={item.coverImage}
              alt={item.collection.name}
              class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="grid h-full w-full place-items-center text-xs font-semibold text-zinc-400 dark:text-zinc-600">
              {item.collection.name}
            </div>
          )}
        </div>

        <div class="p-2">
          <h2 class="truncate text-xs font-semibold leading-tight text-zinc-900 dark:text-white">
            {item.collection.name}
          </h2>
        </div>
      </a>
    ))
  }
</section>
